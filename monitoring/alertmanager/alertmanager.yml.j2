---
# {{ ansible_managed }}
#
# Alertmanager is the half of the alerting pipeline that Prometheus is not.
# Prometheus decides WHEN an alert fires by evaluating rules; Alertmanager
# decides WHO hears about it and HOW — grouping, deduplication, silencing and
# routing to a receiver. Splitting the two means you can silence a noisy alert
# during a deploy without editing (and reloading) the rule that produces it.

global:
  # How long to wait before declaring a firing alert resolved once Prometheus
  # stops sending it. Must exceed Prometheus' evaluation_interval or alerts
  # will flap resolved/firing between evaluations.
  resolve_timeout: 5m

route:
  # Collapse alerts that share these labels into one message rather than
  # sending a separate notification per instance. If all three hosts go down at
  # once you want one alert about three hosts, not three alerts.
  group_by: ["alertname", "severity"]

  # Wait this long after the first alert in a new group before sending, in case
  # more members of the same group arrive.
  group_wait: 30s

  # Minimum gap before sending an update about a group that has changed.
  group_interval: 5m

  # How often to re-send a notification for an alert that is still firing.
  # 4h is deliberately long: a repeat every few minutes trains people to ignore
  # the channel, which is worse than no alerting at all.
  repeat_interval: 4h

  receiver: discord

receivers:
  - name: discord
    discord_configs:
      # Templated from group_vars. The URL contains a token that grants the
      # ability to post to the channel, so it is treated as a credential: kept
      # in an untracked secrets file, and this task runs with no_log.
      - webhook_url: {{ alertmanager_discord_webhook }}
        send_resolved: true
        title: '{% raw %}{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}{% endraw %}'
        message: |-
          {% raw %}{{ range .Alerts }}**{{ .Annotations.summary }}**
          {{ .Annotations.description }}
          Severity: `{{ .Labels.severity }}` — Instance: `{{ .Labels.instance }}`
          {{ end }}{% endraw %}

# Suppress a downstream alert when a more fundamental one is already firing.
# If the whole host is unreachable, TargetDown is the useful signal; AppDown is
# noise that tells you nothing extra.
inhibit_rules:
  - source_matchers: ['alertname = TargetDown']
    target_matchers: ['alertname = AppDown']
    equal: ["instance"]