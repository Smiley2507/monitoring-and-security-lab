global:
  scrape_interval: 15s      
  evaluation_interval: 15s 
  scrape_timeout: 10s

  external_labels:
    monitor: weather-app-observability
    region: {{ aws_region }}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for host in groups['all'] | sort %}
      - targets: ["{{ hostvars[host].private_ip_address }}:9100"]
        labels:
          instance: "{{ host }}"
{% endfor %}

  - job_name: weather-app
    metrics_path: /metrics
    static_configs:
{% for host in groups['role_app'] | default([]) %}
      - targets: ["{{ hostvars[host].private_ip_address }}:80"]
        labels:
          instance: "{{ host }}"
{% endfor %}

  - job_name: jenkins
    metrics_path: /prometheus/
    static_configs:
{% for host in groups['role_jenkins'] | default([]) %}
      - targets: ["{{ hostvars[host].private_ip_address }}:8080"]
        labels:
          instance: "{{ host }}"
{% endfor %}