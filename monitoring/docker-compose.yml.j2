---
# {{ ansible_managed }} — deployed to {{ monitoring_dir }} by the monitoring role.

services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    # NOT published to the host. nginx reaches it over this network.
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus_data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      # 15 days is ample for a lab and bounds disk growth.
      - --storage.tsdb.retention.time=15d
      # Absolute URL so links in the UI and in alerts point at the proxy
      # rather than at the unreachable container port.
      - --web.external-url=http://{{ ansible_host }}:9090/
      # Lets `curl -X POST /-/reload` apply config changes without a restart.
      - --web.enable-lifecycle
    logging:
      driver: awslogs
      options:
        awslogs-region: {{ aws_region }}
        awslogs-group: /monitoring/prometheus
        awslogs-stream: prometheus
        awslogs-create-group: "true"

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    ports:
      - "3000:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana_data:/var/lib/grafana
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_SERVER_ROOT_URL: "http://{{ ansible_host }}:3000/"
      # Nobody should be able to create an account on a monitoring server.
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
    depends_on:
      - prometheus
    logging:
      driver: awslogs
      options:
        awslogs-region: {{ aws_region }}
        awslogs-group: /monitoring/grafana
        awslogs-stream: grafana
        awslogs-create-group: "true"

  alertmanager:
    image: {{ alertmanager_image }}
    container_name: alertmanager
    restart: unless-stopped
    # Not published. Prometheus reaches it over the compose network; there is
    # no reason to expose the silencing UI to the internet.
    expose:
      - "9093"
    volumes:
      # Directory mount, for the same inode reason as Prometheus above.
      - ./alertmanager:/etc/alertmanager:ro
      - alertmanager_data:/alertmanager
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    logging:
      driver: awslogs
      options:
        awslogs-region: {{ aws_region }}
        awslogs-group: /monitoring/alertmanager
        awslogs-stream: alertmanager
        awslogs-create-group: "true"

volumes:
  # Named volumes, because without them Prometheus loses every sample and
  # Grafana loses its database whenever a container is recreated.
  prometheus_data:
  grafana_data:
  alertmanager_data:
