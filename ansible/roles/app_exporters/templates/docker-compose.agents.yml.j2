---
# {{ ansible_managed }} — deployed by the observability repository.
# Deliberately a SEPARATE compose project from the weather-app stack, so a
# redeploy of the application never disturbs the exporters and vice versa.

services:
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    devices:
      - /dev/kmsg
    privileged: true          # required to read cgroup and kernel data
    command:
      # Trim the default metric set; the full set is enormous and most of it
      # is irrelevant here.
      - --docker_only=true
      - --housekeeping_interval=15s
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}

  nginx-exporter:
    image: {{ nginx_exporter_image }}
    container_name: nginx-exporter
    restart: unless-stopped
    # host networking so the scrape of stub_status comes FROM 127.0.0.1.
    # On a bridge network the source would be a 172.x Docker address, and the
    # allow-list in the app's nginx config would return 403.
    network_mode: host
    command:
      - --nginx.scrape-uri=http://127.0.0.1/stub_status
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}
